DEEPLAKE_API_KEY="<YOUR API KEY>"
DEEPLAKE_WORKSPACE="default"
DEEPLAKE_ORG_ID="<YOUR ORG ID>"
DEEPLAKE_API_URL="https://api.deeplake.ai"

ELASTIC_PASSWORD=changeme
KIBANA_PASSWORD=changeme
STACK_VERSION=9.3.2
CLUSTER_NAME=docker-cluster
LICENSE=trial
ES_PORT=9200
KIBANA_PORT=5601
MEM_LIMIT=4294967296
CLERK_SECRET_KEY=<YOUR CLERK KEY>

# Jazz 2.0 sync server (CRDT-primary data layer).
# JAZZ_APP_ID / JAZZ_ADMIN_SECRET: generate once (see migration notes). The same
# app id is exposed to the client as VITE_JAZZ_APP_ID; the admin secret is
# server-only (used to push schema/permissions and run the server).
JAZZ_APP_ID=<your-jazz-app-id>
JAZZ_ADMIN_SECRET=<your-jazz-admin-secret>
# Clerk JWKS endpoint so the Jazz server can validate Clerk session JWTs:
#   https://<your-clerk-frontend-api>/.well-known/jwks.json
JAZZ_JWKS_URL=<your-clerk-jwks-url>
# Client-exposed (Vite). VITE_JAZZ_SERVER_URL points at the jazz service above.
VITE_JAZZ_APP_ID=<your-jazz-app-id>
VITE_JAZZ_SERVER_URL=http://localhost:1625